# Muller-Plathe reverse-NEMD kappa for biaxially strained Si1-xGex
# (P3 pivot, issue 55, 2026-09-29). Same Tersoff-1989 SiCGe.tersoff file
# and the same MP protocol as phase_c/production/in.mp_kappa2, plus a
# biaxial strain eps applied relative to the unstrained box AT THE RUN
# TEMPERATURE (so eps is purely mechanical, thermal expansion excluded).
# Heat always flows along z (the long box axis). Two geometries:
#   dir = 0 (cross-plane): film normal = z; x,y held at (1+eps)*a(T), z free
#   dir = 1 (in-plane):    film normal = y; x,z held at (1+eps)*a(T), y free
# which is a pseudomorphic film on a substrate whose lattice is
# (1+eps) times the alloy's own, e.g. SiGe on Si(001) has eps ~ -0.042 x.
# Variables: -var x -var T -var eps -var dir -var ncz -var seed
#            -var ncxy -var swapn -var pot -var out
variable x     index 0.5
variable T     index 300
variable eps   index 0.0
variable dir   index 0
variable ncz   index 48
variable seed  index 20260929
variable ncxy  index 4
variable swapn index 50
variable pot   index SiCGe.tersoff
variable out   index mp_out

units metal
boundary p p p
variable a0 equal 5.431+(5.658-5.431)*v_x
lattice diamond ${a0}
region box block 0 ${ncxy} 0 ${ncxy} 0 ${ncz}
create_box 2 box
create_atoms 1 box
if "${x} > 0" then "set type 1 type/fraction 2 ${x} ${seed}"
mass 1 28.0855
mass 2 72.63
pair_style tersoff
pair_coeff * * ${pot} Si(D) Ge
timestep 0.001
thermo 10000
velocity all create $(2*v_T) ${seed} dist gaussian

# 1) unstrained box at T: NPT aniso, then average the box
fix npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0
run 30000
variable vlx equal lx
variable vly equal ly
variable vlz equal lz
fix avg all ave/time 10 100 20000 v_vlx v_vly v_vlz
run 20000
variable L0x equal f_avg[1]
variable L0y equal f_avg[2]
variable L0z equal f_avg[3]
variable Lx0 equal ${L0x}
variable Ly0 equal ${L0y}
variable Lz0 equal ${L0z}
unfix avg
unfix npt
print "MPT_UNSTRAINED $(v_Lx0:%.5f) $(v_Ly0:%.5f) $(v_Lz0:%.5f)"

# 2) impose biaxial strain, relax the free (normal) axis at zero stress
if "${dir} == 0" then &
  "change_box all x final 0 $((1+v_eps)*v_Lx0) y final 0 $((1+v_eps)*v_Ly0) remap units box" &
  "fix npt all npt temp ${T} ${T} 0.1 z 0.0 0.0 1.0" &
else &
  "change_box all x final 0 $((1+v_eps)*v_Lx0) z final 0 $((1+v_eps)*v_Lz0) remap units box" &
  "fix npt all npt temp ${T} ${T} 0.1 y 0.0 0.0 1.0"
run 30000
fix avg2 all ave/time 10 100 20000 v_vlx v_vly v_vlz
run 20000
variable Lnx equal f_avg2[1]
variable Lny equal f_avg2[2]
variable Lnz equal f_avg2[3]
variable Lxs equal ${Lnx}
variable Lys equal ${Lny}
variable Lzs equal ${Lnz}
unfix avg2
unfix npt
if "${dir} == 0" then &
  "change_box all z final 0 ${Lzs} remap units box" &
  "variable epsn equal v_Lzs/v_Lz0-1" &
else &
  "change_box all y final 0 ${Lys} remap units box" &
  "variable epsn equal v_Lys/v_Ly0-1"
print "MPT_STRAIN eps_inplane ${eps} eps_normal $(v_epsn:%.6f) dir ${dir}"
fix nvt all nvt temp ${T} ${T} 0.1
run 20000
unfix nvt
compute pe all pe/atom
compute pesum all reduce ave c_pe
thermo_style custom step temp pe c_pesum press pxx pyy pzz
run 0
print "MPT_PE_PER_ATOM $(c_pesum:%.6f)"

# 3) MP rNEMD, heat flow along z (identical to in.mp_kappa2)
fix nve all nve
fix flux all thermal/conductivity ${swapn} z 20
run 100000
print "MPT_EWARM $(f_flux:%.6f)"
compute bins all chunk/atom bin/1d z lower 0.05 units reduced
fix prof all ave/chunk 10 100 1000 bins temp ave running overwrite file ${out}.profile
run 500000
print "MPT_EPROD $(f_flux:%.6f)"
print "MPT_BOX $(lx:%.4f) $(ly:%.4f) $(lz:%.4f)"
print "MPT_NATOMS $(atoms)"
print "MPT_META x ${x} T ${T} ncz ${ncz} seed ${seed} prod_steps 500000 ncxy ${ncxy} swap ${swapn} eps ${eps} dir ${dir}"
