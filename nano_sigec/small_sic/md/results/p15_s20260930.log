# gate G1: no Ge atom may have a C atom within 5.7 A, so no Ge-C pair or
# triplet term is ever evaluated. Checked geometrically: (closest Ge to a
# particle centre) - (farthest C from its centre) >= 5.7 A, at start and end.
group ge type 2
8355 atoms in group ge
group cc type 3
1372 atoms in group cc
variable dA atom sqrt((x-v_cx)^2+(y-v_cy)^2+(z-v_czA)^2)
variable dB atom sqrt((x-v_cx)^2+(y-v_cy)^2+(z-v_czB)^2)
variable dm atom (v_dA<v_dB)*v_dA+(v_dA>=v_dB)*v_dB
compute gemin ge reduce min v_dm
compute cmax cc reduce max v_dm
thermo_style custom step temp pe press c_gemin c_cmax
run 0
