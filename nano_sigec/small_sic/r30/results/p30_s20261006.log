variable cy  equal ly/2
variable czA equal lz/4
variable czB equal 3*lz/4
variable Rs  equal v_R+7.0
if "${shell} == 1" then   "region shA sphere ${cx} ${cy} ${czA} ${Rs} units box"   "region shB sphere ${cx} ${cy} ${czB} ${Rs} units box"   "set region shA type 1"   "set region shB type 1"
region shA sphere ${cx} ${cy} ${czA} ${Rs} units box
